<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- PresentMon v2.5.1 imports a project-local property sheet but not the
       matching targets file. Keep this compatibility shim in the POC only. -->
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props" />
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets" />
</Project>
