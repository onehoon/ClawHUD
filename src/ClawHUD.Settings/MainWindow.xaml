<Window x:Class="ClawHUD.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClawHUD"
        Width="700" Height="744"
        MinWidth="700" MaxWidth="700"
        MinHeight="744" MaxHeight="744"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <!-- All five cards are interactive. Discrete controls: IsChecked one-way
         projects the authoritative snapshot, Click sends one mutation, the
         returned snapshot re-projects. The opacity slider drives live
         PreviewHudOpacity during a drag and one CommitHudOpacity on release; its
         thumb follows the gesture, not the snapshot, while dragging. Discrete
         controls and the opacity slider are mutually exclusive. Geometry
         unchanged from PR1. -->
    <Grid Margin="12">
        <StackPanel>

            <!-- Card 1: HUD enable + display mode -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel IsEnabled="{Binding AreDiscreteSettingsControlsEnabled}">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SettingToggleSwitch}"
                                      IsChecked="{Binding HudEnabled, Mode=OneWay}" Click="OnEnableHudClick" />
                        <TextBlock Style="{StaticResource SettingLabel}" Margin="0" Text="Enable HUD" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,8,0,3" Text="Display mode" />
                    <UniformGrid Rows="1" Columns="2">
                        <ToggleButton Style="{StaticResource SegmentToggle}" Margin="0,0,3,0" Content="In-game only"
                                      Tag="InGameOnly" Click="OnVisibilityModeClick"
                                      IsChecked="{Binding IsVisibilityInGameOnly, Mode=OneWay}" />
                        <ToggleButton Style="{StaticResource SegmentToggle}" Margin="3,0,0,0" Content="Always"
                                      Tag="Always" Click="OnVisibilityModeClick"
                                      IsChecked="{Binding IsVisibilityAlways, Mode=OneWay}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Card 2: HUD size + font + alignment -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel IsEnabled="{Binding AreDiscreteSettingsControlsEnabled}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource StepperButton}" Content="&#x2212;"
                                    Click="OnHudSizeDecreaseClick" IsEnabled="{Binding CanDecreaseHudSize}" />
                            <TextBlock Text="{Binding HudSizeLabel}" VerticalAlignment="Center" Margin="12,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Button Style="{StaticResource StepperButton}" Content="+"
                                    Click="OnHudSizeIncreaseClick" IsEnabled="{Binding CanIncreaseHudSize}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Margin="0" Text="HUD size" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,8,0,3" Text="Font" />
                    <UniformGrid Rows="1" Columns="2">
                        <ToggleButton Style="{StaticResource SegmentToggle}" Margin="0,0,3,0" Content="Unispace"
                                      Tag="Unispace" Click="OnFontClick"
                                      IsChecked="{Binding IsFontUnispace, Mode=OneWay}" />
                        <ToggleButton Style="{StaticResource SegmentToggle}" Margin="3,0,0,0" Content="Segoe UI Variable"
                                      Tag="SegoeUiVariable" Click="OnFontClick"
                                      IsChecked="{Binding IsFontSegoeUiVariable, Mode=OneWay}" />
                    </UniformGrid>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,8,0,3" Text="Alignment" />
                    <UniformGrid Rows="1" Columns="3">
                        <ToggleButton Style="{StaticResource SegmentToggle}" Margin="0,0,3,0" Content="Left"
                                      Tag="Left" Click="OnAlignmentClick"
                                      IsChecked="{Binding IsAlignmentLeft, Mode=OneWay}" />
                        <ToggleButton Style="{StaticResource SegmentToggle}" Margin="3,0" Content="Center"
                                      Tag="Center" Click="OnAlignmentClick"
                                      IsChecked="{Binding IsAlignmentCenter, Mode=OneWay}" />
                        <ToggleButton Style="{StaticResource SegmentToggle}" Margin="3,0,0,0" Content="Right"
                                      Tag="Right" Click="OnAlignmentClick"
                                      IsChecked="{Binding IsAlignmentRight, Mode=OneWay}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Card 3: background width (discrete) + background opacity (preview/commit slider) -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel IsEnabled="{Binding AreDiscreteSettingsControlsEnabled}">
                        <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,3" Text="Background width" />
                        <UniformGrid Rows="1" Columns="2">
                            <ToggleButton Style="{StaticResource SegmentToggle}" Margin="0,0,3,0" Content="Full width"
                                          Tag="FullWidth" Click="OnBackgroundModeClick"
                                          IsChecked="{Binding IsBackgroundFullWidth, Mode=OneWay}" />
                            <ToggleButton Style="{StaticResource SegmentToggle}" Margin="3,0,0,0" Content="Content width"
                                          Tag="ContentWidth" Click="OnBackgroundModeClick"
                                          IsChecked="{Binding IsBackgroundContentWidth, Mode=OneWay}" />
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingLabel}" Margin="0,6,0,2" Text="Background opacity" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundOpacityText}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <!-- Value is pushed from code-behind under a guard so a
                                 programmatic snapshot update never looks like user input.
                                 ValueChanged is wired in the constructor AFTER the ViewModel
                                 exists — never in XAML — so the Minimum 0 -> 50 coercion
                                 during InitializeComponent is not a user opacity mutation. -->
                            <Slider x:Name="OpacitySlider" Minimum="50" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center" MinHeight="40"
                                    IsEnabled="{Binding IsOpacitySliderEnabled}"
                                    Thumb.DragStarted="OnOpacityDragStarted"
                                    Thumb.DragCompleted="OnOpacityDragCompleted" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: Intel VRR Range Fix -->
            <Border Style="{StaticResource SettingsCard}">
                <DockPanel IsEnabled="{Binding AreDiscreteSettingsControlsEnabled}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SettingToggleSwitch}"
                                  IsChecked="{Binding IntelVrrRangeFixEnabled, Mode=OneWay}"
                                  Click="OnIntelVrrRangeFixClick" />
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0" Text="Intel VRR Range Fix" />
                </DockPanel>
            </Border>

            <!-- Card 5: Start with Windows -->
            <Border Style="{StaticResource SettingsCard}">
                <DockPanel IsEnabled="{Binding AreDiscreteSettingsControlsEnabled}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SettingToggleSwitch}"
                                  IsChecked="{Binding StartWithWindows, Mode=OneWay}"
                                  Click="OnStartWithWindowsClick" />
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0" Text="Start with Windows" />
                </DockPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
